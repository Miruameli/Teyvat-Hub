<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Visual styling lives in Compose (see presentation/core/theme/Theme.kt).
      This XML theme only needs to let the activity draw edge to edge and
      avoid an abrupt white flash before the first frame.

      The parent is an AppCompat theme because the activity is an
      AppCompatActivity: the compatible per-app locale API only reaches
      activities that AppCompat manages, and AppCompatActivity refuses to
      start under a theme that is not an AppCompat theme.
    -->
    <style name="Theme.TeyvatHub" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.TeyvatHub.NoActionBar" parent="Theme.TeyvatHub" />

</resources>
